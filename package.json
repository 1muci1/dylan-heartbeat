{
  "name": "kelivo-gateway",
  "version": "1.0.0",
  "description": "A local Kelivo gateway that keeps timed chat context and lets your character send optional Bark wake-up messages.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "wake": "node wake_up.js",
    "delivery-worker": "node proactive-delivery-runtime.js",
    "test": "node --test test/*.test.js",
    "migrate:memory": "node scripts/migrate-memory-json.js",
    "mcp:draw": "node mcp-draw-server.js"
  },
  "keywords": [
    "fastify",
    "gateway",
    "api-gateway",
    "node-cron",
    "kelivo"
  ],
  "author": "callie0313",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.4.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.3.3",
    "fs-extra": "^11.3.5",
    "node-cron": "^4.2.1"
  }
}
